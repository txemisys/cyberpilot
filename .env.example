DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberpilot"
AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# CyberPilot application sign-in.
# This Entra app authenticates CyberPilot users and should not carry
# application-level Microsoft Graph scanning permissions.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Microsoft 365 security scanner.
# Use a separate multi-tenant Entra app with application permissions.
M365_GRAPH_CLIENT_ID=""
M365_GRAPH_CLIENT_SECRET=""
M365_GRAPH_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft-365/callback"

# Microsoft 365 remediation executor.
# Keep this separate from the read-only scanner app. Configure only when
# automated remediation is intentionally enabled for a tenant.
# The first automated action requires Microsoft Graph application permission:
# RoleManagement.ReadWrite.Directory (admin consent required).
M365_REMEDIATION_CLIENT_ID=""
M365_REMEDIATION_CLIENT_SECRET=""

M365_REMEDIATION_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft-365/remediation/callback"
