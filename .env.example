DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberpilot"
AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Local development only. Enables email/password login so Microsoft 365 Lab
# Mode can be tested without a Microsoft tenant. It is ignored in production.
LAB_AUTH_ENABLED="false"

# CyberPilot application sign-in.
# This Entra app authenticates CyberPilot users and should not carry
# application-level Microsoft Graph scanning permissions.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Microsoft 365 security scanner.
# Use a separate multi-tenant Entra app with application permissions only.
# Production: store the secret in the deployment secret manager, never in Git,
# and rotate it according to your credential policy. Prefer certificate/federated
# credentials in a later production-hardening step where the host supports them.
M365_GRAPH_CLIENT_ID=""
M365_GRAPH_CLIENT_SECRET=""
M365_GRAPH_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft-365/callback"

# Microsoft 365 remediation executor.
# Keep this separate from the read-only scanner app. Configure only when
# automated remediation is intentionally enabled for a tenant.
# The first automated action requires Microsoft Graph application permission:
# RoleManagement.ReadWrite.Directory (admin consent required).
M365_REMEDIATION_CLIENT_ID=""
M365_REMEDIATION_CLIENT_SECRET=""

M365_REMEDIATION_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft-365/remediation/callback"

# Production safety notes:
# - use an https:// BETTER_AUTH_URL and https:// Microsoft redirect URIs
# - use a strong random AUTH_SECRET; never use the example value
# - keep LAB_AUTH_ENABLED=false
# - do not configure M365_REMEDIATION_* until real write capability is intended

# FIRST LIVE TENANT SAFETY:
# Leave all M365_REMEDIATION_* variables empty during the first real tenant
# validation. Configure only the dedicated read-only scanner app and run the
# read-only readiness probe before the first full sync.


# STAGING / PRODUCTION:
# Production validation requires HTTPS public URLs, a non-example AUTH_SECRET
# of at least 32 characters, Microsoft login credentials and the dedicated
# read-only scanner credentials. LAB_AUTH_ENABLED must remain false.
