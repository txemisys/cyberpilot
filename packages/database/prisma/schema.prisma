generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

enum AuditActorType {
  USER
  SYSTEM
  INTEGRATION
}

enum IntegrationProvider {
  MICROSOFT_365
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum IntegrationMode {
  LIVE
  LAB
}

enum IntegrationCapabilityStatus {
  UNKNOWN
  AVAILABLE
  PERMISSION_REQUIRED
  ERROR
}

enum IntegrationConsentPurpose {
  SCANNER
  REMEDIATION
}

enum DirectoryIdentityType {
  MEMBER
  GUEST
  UNKNOWN
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  RESOLVED
}

enum DomainSpfStatus {
  UNKNOWN
  MISSING
  PRESENT
  MULTIPLE
  ERROR
}

enum DomainDmarcStatus {
  UNKNOWN
  MISSING
  MONITORING
  ENFORCING
  INVALID
  ERROR
}

enum DomainDkimStatus {
  UNKNOWN
  MISSING
  PARTIAL
  PUBLISHED
  ERROR
}

enum ScoreCoverage {
  COMPLETE
  PARTIAL
}

enum WorkHandoffStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkItemEventKind {
  CREATED
  UPDATED
  COMMENTED
  REOPENED
}

enum RemediationMode {
  GUIDED
  AUTOMATED
}

enum RemediationStatus {
  PROPOSED
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  CANCELLED
  VERIFIED
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships              Membership[]
  auditEvents              AuditEvent[]             @relation("AuditUser")
  integrationConsentStates IntegrationConsentState[]
  approvedRemediations      Remediation[] @relation("RemediationApprover")
  assignedWorkItems         RemediationWorkItem[] @relation("WorkItemAssignee")
  workItemEvents            RemediationWorkEvent[] @relation("WorkEventActor")
  completedChecklistEntries WorkChecklistEntry[] @relation("ChecklistCompleter")
  linkedWorkEvidence WorkEvidenceLink[] @relation("WorkEvidenceLinker")
  unlinkedWorkEvidence WorkEvidenceLink[] @relation("WorkEvidenceUnlinker")
  requestedHandoffs WorkHandoff[] @relation("HandoffRequester")
  assignedHandoffs WorkHandoff[] @relation("HandoffRecipient")
  decidedHandoffs WorkHandoff[] @relation("HandoffDecider")
  createdIntegrityCaptures IntegrityCaseCapture[] @relation("IntegrityCaptureCreator")
  integrityReviewEvents IntegrityReviewEvent[] @relation("IntegrityReviewEventActor")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships              Membership[]
  auditEvents              AuditEvent[]
  integrations             Integration[]
  integrationConsentStates IntegrationConsentState[]
  findings                 SecurityFinding[]
  domains                  Domain[]
  securityScores           SecurityScore[]
  remediations             Remediation[]
  securityEvidence         SecurityEvidence[]
  remediationWorkItems      RemediationWorkItem[]
  remediationWorkEvents     RemediationWorkEvent[]
  workChecklistEntries      WorkChecklistEntry[]
  workEvidenceLinks         WorkEvidenceLink[]
  workHandoffs              WorkHandoff[]
  assetInventoryImports     AssetInventoryImport[]
  assetInventoryDevices     AssetInventoryDevice[]
  assetOsvInspections       AssetOsvInspection[]
  assetOsvQueries           AssetOsvQueryRecord[]
  assetOsvQuotaDays         AssetOsvQuotaDay[]
  assetOsvReservations      AssetOsvQuotaReservation[]
  assetOsvSchedules         AssetOsvRenewalSchedule[]
  assetOsvScheduleRuns      AssetOsvRenewalRun[]
  assetOsvDispatchNonces    AssetOsvDispatchNonce[]
  assetOsvDispatchAlerts    AssetOsvDispatchAlert[]
  assetAdviceCases         AssetAdviceCase[]
  integrityCaseCaptures     IntegrityCaseCapture[]
  integrityReviewTasks      IntegrityReviewTask[]
  integrityReviewEvents     IntegrityReviewEvent[]
  integrityReviewCommands   IntegrityReviewCommand[]
  integrityEvidenceAssessments IntegrityEvidenceAssessment[]
  integrityReviewWorkLinks IntegrityReviewWorkLink[]
  integrityProviderChecks IntegrityProviderCheck[]
  integrityNotifications IntegrityNotification[]
  integrityEscalations IntegrityEscalation[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Integration {
  id               String              @id @default(cuid())
  organizationId   String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(PENDING)
  mode             IntegrationMode     @default(LIVE)
  externalTenantId String?
  displayName      String?
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorCode    String?
  lastErrorEventId String?
  mfaEvidenceStatus IntegrationCapabilityStatus @default(UNKNOWN)
  mfaEvidenceCheckedAt DateTime?
  remediationStatus IntegrationCapabilityStatus @default(UNKNOWN)
  remediationCheckedAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identities      DirectoryIdentity[]
  roleDefinitions DirectoryRoleDefinition[]
  roleAssignments DirectoryRoleAssignment[]
  findings        SecurityFinding[]
  domains         Domain[]
  syncLease       IntegrationSyncLease?

  @@unique([organizationId, provider])
  @@unique([provider, externalTenantId])
  @@index([organizationId])
}


model IntegrationSyncLease {
  integrationId String   @id
  leaseToken    String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model DirectoryIdentity {
  id                String                @id @default(cuid())
  integrationId     String
  externalId        String
  displayName       String?
  userPrincipalName String?
  accountEnabled    Boolean?
  identityType              DirectoryIdentityType @default(UNKNOWN)
  createdAtProvider         DateTime?
  isAdmin                   Boolean?
  isMfaRegistered           Boolean?
  isMfaCapable              Boolean?
  isPasswordlessCapable     Boolean?
  methodsRegistered         Json?
  authenticationObservedAt  DateTime?
  authenticationUpdatedAt   DateTime?
  observedAt                DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([integrationId, accountEnabled])
}

model DirectoryRoleDefinition {
  id            String   @id @default(cuid())
  integrationId String
  externalId    String
  templateId    String?
  displayName   String
  isBuiltIn     Boolean?
  observedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration               @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  assignments DirectoryRoleAssignment[]

  @@unique([integrationId, externalId])
  @@index([integrationId])
}

model DirectoryRoleAssignment {
  id                       String   @id @default(cuid())
  integrationId            String
  externalId               String
  principalExternalId      String
  roleDefinitionExternalId String
  directoryScopeId         String?
  observedAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  integration    Integration             @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  roleDefinition DirectoryRoleDefinition @relation(fields: [integrationId, roleDefinitionExternalId], references: [integrationId, externalId], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([integrationId, principalExternalId])
  @@index([integrationId, roleDefinitionExternalId])
}




model Domain {
  id             String            @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  isDefault      Boolean           @default(false)
  isInitial      Boolean           @default(false)
  spfStatus      DomainSpfStatus   @default(UNKNOWN)
  spfRecords     Json?
  dmarcStatus    DomainDmarcStatus @default(UNKNOWN)
  dmarcPolicy    String?
  dmarcRecords   Json?
  dkimStatus     DomainDkimStatus  @default(UNKNOWN)
  dkimSelectors  Json?
  dnsObservedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([integrationId])
  @@index([organizationId, isInitial])
}


model SecurityEvidence {
  id             String   @id @default(cuid())
  organizationId String
  schemaVersion  Int      @default(1)
  source         String
  domain         String
  controlId      String
  state          String
  scope          String
  observedAt     DateTime?
  details        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workLinks WorkEvidenceLink[]
  integrityAssessments IntegrityEvidenceAssessment[]
  integrityProviderChecks IntegrityProviderCheck[]

  @@unique([organizationId, source, domain, controlId, scope])
  @@index([organizationId, domain, state])
}

model SecurityFinding {
  id             String          @id @default(cuid())
  organizationId String
  integrationId  String?
  key            String
  ruleId         String
  title          String
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  evidence       Json?
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  remediations Remediation[]
  workItems RemediationWorkItem[]

  @@unique([organizationId, key])
  @@index([organizationId, status, severity])
  @@index([integrationId])
}



model Remediation {
  id                String            @id @default(cuid())
  organizationId    String
  findingId         String
  playbookId        String
  mode              RemediationMode
  status            RemediationStatus @default(PROPOSED)
  title             String
  summary           String
  steps             Json
  verification      Json
  actionType        String?
  actionPayload     Json?
  executionEvidence Json?
  failureCode       String?
  approvedByUserId  String?
  approvedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  guidedProgress GuidedRemediationStep[]
  workItems RemediationWorkItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding        SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  approvedByUser User?           @relation("RemediationApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([findingId])
}

model RemediationWorkItem {
  id String @id @default(cuid())
  organizationId String
  remediationId String
  findingId String
  title String
  description String @default("")
  status WorkItemStatus @default(TODO)
  priority WorkItemPriority @default(NORMAL)
  assigneeUserId String?
  dueAt DateTime?
  completedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediation Remediation @relation(fields: [remediationId], references: [id], onDelete: Cascade)
  finding SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee User? @relation("WorkItemAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  events RemediationWorkEvent[]
  checklist WorkChecklistEntry[]
  evidenceLinks WorkEvidenceLink[]
  integrityReviewLinks IntegrityReviewWorkLink[]
  handoffs WorkHandoff[]

  @@unique([organizationId, remediationId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeUserId, status])
  @@index([organizationId, priority, createdAt])
}

model WorkHandoff {
  id String @id @default(cuid())
  organizationId String
  workItemId String
  requesterUserId String?
  recipientUserId String
  decidedByUserId String?
  status WorkHandoffStatus @default(REQUESTED)
  reason String
  response String?
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  expiresAt DateTime?
  revision Int @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workItem RemediationWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requester User? @relation("HandoffRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  recipient User @relation("HandoffRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  decider User? @relation("HandoffDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, workItemId, requestedAt])
  @@index([organizationId, recipientUserId, status])
  @@index([organizationId, status, expiresAt])
}

model WorkEvidenceLink {
  id String @id @default(cuid())
  organizationId String
  workItemId String
  evidenceId String
  reason String
  linkedByUserId String?
  linkedAt DateTime @default(now())
  unlinkedAt DateTime?
  unlinkedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workItem RemediationWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  evidence SecurityEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  linkedBy User? @relation("WorkEvidenceLinker", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  unlinkedBy User? @relation("WorkEvidenceUnlinker", fields: [unlinkedByUserId], references: [id], onDelete: SetNull)

  @@unique([workItemId, evidenceId])
  @@index([organizationId, workItemId, unlinkedAt])
  @@index([organizationId, evidenceId])
}

model WorkChecklistEntry {
  id String @id @default(cuid())
  organizationId String
  workItemId String
  position Int
  title String
  description String @default("")
  completedAt DateTime?
  completedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workItem RemediationWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  completedBy User? @relation("ChecklistCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([workItemId, position])
  @@index([organizationId, workItemId, completedAt])
}

model RemediationWorkEvent {
  id String @id @default(cuid())
  organizationId String
  workItemId String
  actorUserId String?
  kind WorkItemEventKind
  before Json?
  after Json?
  comment String?
  occurredAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workItem RemediationWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor User? @relation("WorkEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, workItemId, occurredAt])
  @@index([organizationId, actorUserId, occurredAt])
}

model GuidedRemediationStep {
  id             String   @id @default(cuid())
  organizationId String
  remediationId  String
  stepIndex      Int
  actorUserId    String
  acknowledgedAt DateTime @default(now())

  remediation Remediation @relation(fields: [remediationId], references: [id], onDelete: Cascade)

  @@unique([remediationId, stepIndex])
  @@index([organizationId, remediationId])
}

model SecurityScore {
  id                      String        @id @default(cuid())
  organizationId          String
  modelVersion            String
  score                   Int
  riskPoints              Float
  coverage                ScoreCoverage
  supportedFindingCount   Int
  unsupportedFindingCount Int
  details                 Json?
  calculatedAt            DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, calculatedAt])
}

model IntegrationConsentState {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  provider       IntegrationProvider
  purpose        IntegrationConsentPurpose @default(SCANNER)
  nonceHash      String              @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, purpose, expiresAt])
  @@index([userId, expiresAt])
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  actorType      AuditActorType
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  occurredAt     DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation("AuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([actorUserId])
}


model IntegrityCaseCapture {
  id             String   @id @default(cuid())
  organizationId String
  source         String
  capturedAt     DateTime
  complete       Boolean
  caseCount      Int
  digest         String   @db.VarChar(64)
  payload        Json
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("IntegrityCaptureCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewTasks IntegrityReviewTask[]

  @@unique([organizationId, source, capturedAt])
  @@index([organizationId, capturedAt])
  @@index([organizationId, source, capturedAt])
}


enum IntegrityReviewDisposition {
  OPEN
  ACKNOWLEDGED
  IN_REVIEW
  RESOLVED
  WAIVED
  REOPENED
}

enum IntegrityReviewAction {
  ACKNOWLEDGE
  START_REVIEW
  RESOLVE
  WAIVE
  REOPEN
}

model IntegrityReviewTask {
  id               String @id @default(cuid())
  organizationId   String
  captureId        String
  externalTaskId   String
  title            String
  severity         String
  required         Boolean @default(true)
  disposition      IntegrityReviewDisposition @default(OPEN)
  revision         Int @default(1)
  ownerUserId      String?
  resolutionReason String?
  resolutionRefs   Json?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capture IntegrityCaseCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  events IntegrityReviewEvent[]
  commands IntegrityReviewCommand[]
  evidenceAssessments IntegrityEvidenceAssessment[]
  workLinks IntegrityReviewWorkLink[]
  providerChecks IntegrityProviderCheck[]
  notifications IntegrityNotification[]
  escalations IntegrityEscalation[]
  assessmentRevision Int @default(0)

  @@unique([organizationId, captureId, externalTaskId])
  @@index([organizationId, disposition, updatedAt])
  @@index([organizationId, captureId, createdAt])
}

model IntegrityReviewEvent {
  id             String @id @default(cuid())
  organizationId String
  taskId         String
  actorUserId    String?
  action         IntegrityReviewAction
  revisionBefore Int
  revisionAfter  Int
  before         IntegrityReviewDisposition
  after          IntegrityReviewDisposition
  reason         String?
  evidenceRefs   Json?
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("IntegrityReviewEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, revisionAfter])
  @@index([organizationId, taskId, occurredAt])
  @@index([organizationId, actorUserId, occurredAt])
}

model IntegrityReviewCommand {
  id             String @id @default(cuid())
  organizationId String
  taskId         String
  actorUserId    String
  idempotencyKey String
  payloadDigest  String @db.VarChar(64)
  response       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, taskId, createdAt])
}

model RequestRateLimit {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, subjectHash, windowStart])
  @@index([expiresAt])
}

/**
 * Human review of a specific evidence observation, not an assertion that
 * the underlying control is independently verified by a provider.
 */
enum IntegrityEvidenceDecision {
  ACCEPTED
  REJECTED
  INCONCLUSIVE
}

model IntegrityEvidenceAssessment {
  id String @id @default(cuid())
  organizationId String
  taskId String
  evidenceId String
  assessorUserId String?
  decision IntegrityEvidenceDecision
  rationale String
  observationDigest String @db.VarChar(64)
  observedAt DateTime?
  source String
  controlId String
  evidenceState String
  evidenceUpdatedAt DateTime
  revision Int
  idempotencyKey String
  requestDigest String @db.VarChar(64)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evidence SecurityEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, assessorUserId, idempotencyKey])
  @@unique([taskId, revision])
  @@index([organizationId, taskId, createdAt])
  @@index([organizationId, evidenceId, createdAt])
}

/**
 * Explicit operational association between an integrity review and a work item.
 * A link is not a claim that the work remediated or independently verified a case.
 */
model IntegrityReviewWorkLink {
  id String @id @default(cuid())
  organizationId String
  taskId String
  workItemId String
  rationale String
  linkedByUserId String?
  linkedAt DateTime @default(now())
  unlinkedAt DateTime?
  unlinkedByUserId String?
  unlinkReason String?
  revision Int @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workItem RemediationWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taskId, workItemId])
  @@index([organizationId, taskId, unlinkedAt])
  @@index([organizationId, workItemId, unlinkedAt])
}

/**
 * Append-only result of an actual remote provider read. This is separate
 * from human assessments, and does not mutate remediation or CyberScore.
 */
model IntegrityProviderCheck {
  id String @id @default(cuid())
  organizationId String
  taskId String
  evidenceId String
  provider String
  subject String
  controlId String
  outcome String
  providerObservedAt DateTime?
  checkedAt DateTime @default(now())
  requestedByUserId String?
  requestKey String
  requestDigest String @db.VarChar(64)
  observationDigest String @db.VarChar(64)
  responseDigest String @db.VarChar(64)
  responseMetadata Json
  failureCode String?
  failureMessage String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evidence SecurityEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  @@unique([organizationId, requestedByUserId, requestKey])
  @@index([organizationId, taskId, checkedAt])
  @@index([organizationId, evidenceId, checkedAt])
  @@index([organizationId, provider, checkedAt])
}

enum IntegrityNotificationKind {
  REVIEW_ASSIGNED
  REVIEW_OVERDUE
  REVIEW_ESCALATED
  REVIEW_RESOLVED
  PROVIDER_FAILURE
  PROVIDER_RECOVERED
}

enum IntegrityEscalationState {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

model IntegrityNotification {
  id String @id @default(cuid())
  organizationId String
  taskId String
  recipientUserId String
  kind IntegrityNotificationKind
  dedupeKey String
  title String
  message String
  context Json?
  createdAt DateTime @default(now())
  readAt DateTime?
  dismissedAt DateTime?
  revision Int @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recipientUserId, dedupeKey])
  @@index([organizationId, recipientUserId, createdAt])
  @@index([organizationId, taskId, createdAt])
  @@index([organizationId, recipientUserId, readAt])
}

model IntegrityEscalation {
  id String @id @default(cuid())
  organizationId String
  taskId String
  level Int @default(1)
  state IntegrityEscalationState @default(OPEN)
  reason String
  dedupeKey String
  dueAt DateTime
  openedAt DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  actorUserId String?
  revision Int @default(1)
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task IntegrityReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taskId, dedupeKey])
  @@index([organizationId, state, dueAt])
  @@index([organizationId, taskId, openedAt])
}

enum AssetImportState {
  COMMITTED
  RETIRED
}

model AssetInventoryImport {
  id String @id @default(cuid())
  organizationId String
  actorUserId String?
  idempotencyKey String
  payloadDigest String @db.VarChar(64)
  sourceLabel String
  state AssetImportState @default(COMMITTED)
  schemaVersion Int @default(1)
  declaredCount Int
  importedCount Int
  duplicateCount Int
  unknownVersionCount Int
  advisorySources Json @default("[]")
  createdAt DateTime @default(now())
  retiredAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  devices AssetInventoryDevice[]
  osvInspections AssetOsvInspection[]
  osvSchedules AssetOsvRenewalSchedule[]
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, state, createdAt])
}

model AssetInventoryDevice {
  id String @id @default(cuid())
  organizationId String
  importId String
  externalId String
  hostname String?
  ownerHash String? @db.VarChar(64)
  platform String
  osName String
  osVersion String?
  softwareName String @default("")
  softwareVersion String?
  observedAt DateTime
  sourceRow Int
  normalizedProductKey String @default("")
  versionStatus String
  freshnessStatus String
  advisoryStatus String
  advisoryIds Json @default("[]")
  confidence String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import AssetInventoryImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  @@unique([importId, externalId, normalizedProductKey], map: "AssetInvDevice_import_external_product_key")
  @@index([organizationId, externalId, observedAt])
  @@index([organizationId, platform, osName])
  @@index([organizationId, importId])
}

/**
 * Immutable outcome of an administrator-authorized OSV inspection.
 * Stores normalized query reports, not raw provider traffic or device IDs.
 * A replay key is scoped to one organization and one command fingerprint.
 */
model AssetOsvInspection {
  id String @id @default(cuid())
  organizationId String
  inventoryImportId String
  actorUserId String?
  requestKey String
  requestDigest String @db.VarChar(64)
  reportDigest String @db.VarChar(64)
  status String
  provider String @default("OSV_DEV_API")
  coverage String @default("DECLARED_NOT_VERIFIED")
  report Json
  queryCount Int
  completedCount Int
  possibleCount Int
  providerOnlyCount Int
  createdAt DateTime @default(now())
  completedAt DateTime
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryImport AssetInventoryImport @relation(fields: [inventoryImportId], references: [id], onDelete: Cascade)
  queries AssetOsvQueryRecord[]
  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, inventoryImportId, createdAt])
}

model AssetOsvQueryRecord {
  id String @id @default(cuid())
  organizationId String
  inspectionId String
  queryKey String @db.VarChar(64)
  ecosystem String
  packageName String
  version String
  providerStatus String
  providerDigest String? @db.VarChar(64)
  checkedAt DateTime?
  possibleIds Json @default("[]")
  providerOnlyIds Json @default("[]")
  withdrawnIds Json @default("[]")
  unresolvedIds Json @default("[]")
  observationCount Int
  pageCount Int
  recordedAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection AssetOsvInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@unique([inspectionId, queryKey])
  @@index([organizationId, ecosystem, packageName, version])
  @@index([organizationId, inspectionId])
}

/** Per-tenant UTC-day hard reservation counters. Reservations are charged
 * before outbound network requests and are never refunded automatically. */
model AssetOsvQuotaDay {
  id String @id @default(cuid())
  organizationId String
  utcDay DateTime @db.Date
  inspectionLimit Int @default(20)
  requestLimit Int @default(200)
  inspectionsReserved Int @default(0)
  requestsReserved Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations AssetOsvQuotaReservation[]
  @@unique([organizationId, utcDay])
  @@index([organizationId, updatedAt])
}

/** Append-only reservation journal: failure still consumes conservatively
 * the reserved request budget because the provider may have received it. */
model AssetOsvQuotaReservation {
  id String @id @default(cuid())
  organizationId String
  quotaDayId String
  requestKey String
  requestDigest String @db.VarChar(64)
  inventoryImportId String
  reservedRequests Int
  state String @default("RESERVED")
  actualRequests Int @default(0)
  errorCode String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotaDay AssetOsvQuotaDay @relation(fields: [quotaDayId], references: [id], onDelete: Cascade)
  @@unique([organizationId, requestKey])
  @@index([organizationId, startedAt])
  @@index([quotaDayId, state])
}

/** Explicit organization-authorized recurring provider renewal definition.
 * Stored but disabled by default. No automatic cron is installed by schema. */
model AssetOsvRenewalSchedule {
  id String @id @default(cuid())
  organizationId String
  inventoryImportId String
  sourceInspectionId String
  createdByUserId String
  name String
  enabled Boolean @default(false)
  cadenceMinutes Int
  nextDueAt DateTime
  policy Json
  inspection Json
  allowNewPackages Boolean @default(false)
  allowIncompleteInventory Boolean @default(false)
  outboundConsent Boolean @default(false)
  consentedAt DateTime?
  consentDigest String @db.VarChar(64)
  revision Int @default(1)
  lastAttemptAt DateTime?
  lastSucceededAt DateTime?
  lastRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryImport AssetInventoryImport @relation(fields: [inventoryImportId], references: [id], onDelete: Cascade)
  runs AssetOsvRenewalRun[]
  @@index([organizationId, enabled, nextDueAt])
  @@index([organizationId, inventoryImportId])
}

/** Durable scheduler claim with one slot per schedule/UTC cadence.
 * Terminal failures never trigger implicit network retries. */
model AssetOsvRenewalRun {
  id String @id @default(cuid())
  organizationId String
  scheduleId String
  slotAt DateTime
  state String @default("CLAIMED")
  commandDigest String @db.VarChar(64)
  claimToken String @db.VarChar(64)
  claimExpiresAt DateTime
  requestedByUserId String?
  inspectionId String?
  result Json?
  errorCode String?
  claimedAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule AssetOsvRenewalSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, slotAt])
  @@index([organizationId, state, claimedAt])
  @@index([organizationId, scheduleId, slotAt])
}

/** Per-organization replay protection for authenticated service dispatches.
 * Secrets and signatures are never persisted. Digest ties a nonce to one intent. */
model AssetOsvDispatchNonce {
  id String @id @default(cuid())
  organizationId String
  nonceDigest String @db.VarChar(64)
  requestDigest String @db.VarChar(64)
  keyId String @db.VarChar(100)
  scheduleId String
  acceptedAt DateTime @default(now())
  expiresAt DateTime
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, nonceDigest])
  @@index([organizationId, acceptedAt])
  @@index([organizationId, expiresAt])
}

/** Operator-triaged, tenant-scoped OSV scheduler alert.
 * An ACKNOWLEDGED alert is not a resolved provider incident. */
model AssetOsvDispatchAlert {
  id String @id @default(cuid())
  organizationId String
  code String @db.VarChar(80)
  subjectKey String @db.VarChar(100)
  severity String
  state String @default("OPEN")
  revision Int @default(1)
  firstSeenAt DateTime
  lastSeenAt DateTime
  observedCount Int @default(1)
  evidenceDigest String @db.VarChar(64)
  evidence Json
  acknowledgementReason String?
  acknowledgedByUserId String?
  acknowledgedAt DateTime?
  resolutionReason String?
  resolvedByUserId String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, code, subjectKey])
  @@index([organizationId, state, lastSeenAt])
  @@index([organizationId, severity, lastSeenAt])
  @@index([organizationId, createdAt])
}

/** Human review of declared-inventory OSV candidates, never a SecurityFinding. */
model AssetAdviceCase {
  id String @id @default(cuid())
  organizationId String
  importId String
  inspectionId String
  evidenceFingerprint String @db.VarChar(64)
  inventoryDigest String @db.VarChar(64)
  inspectionDigest String @db.VarChar(64)
  externalId String @db.VarChar(100)
  normalizedProductKey String @db.VarChar(200)
  softwareVersion String?
  status String @default("OPEN")
  category String
  priority String
  revision Int @default(1)
  title String @db.VarChar(220)
  rationale Json
  actions Json
  advisoryIds Json @default("[]")
  openedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastDecisionAt DateTime?
  lastDecisionReason String?
  lastDecisionUserId String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps AssetAdviceCaseStep[]
  @@unique([organizationId, inspectionId, externalId, normalizedProductKey], map: "AssetAdviceCase_org_inspection_asset_product")
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, importId])
  @@index([organizationId, inspectionId])
}
/** A step tracks human work only; DONE never means verified vulnerability resolution. */
model AssetAdviceCaseStep {
  id String @id @default(cuid())
  organizationId String
  caseId String
  actionCode String @db.VarChar(80)
  status String @default("TODO")
  revision Int @default(1)
  note String?
  completedAt DateTime?
  completedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adviceCase AssetAdviceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@unique([caseId, actionCode])
  @@index([organizationId, status])
}
