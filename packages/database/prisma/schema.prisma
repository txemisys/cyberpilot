generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

enum AuditActorType {
  USER
  SYSTEM
  INTEGRATION
}

enum IntegrationProvider {
  MICROSOFT_365
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum IntegrationCapabilityStatus {
  UNKNOWN
  AVAILABLE
  PERMISSION_REQUIRED
  ERROR
}

enum DirectoryIdentityType {
  MEMBER
  GUEST
  UNKNOWN
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  RESOLVED
}

enum DomainSpfStatus {
  UNKNOWN
  MISSING
  PRESENT
  MULTIPLE
  ERROR
}

enum DomainDmarcStatus {
  UNKNOWN
  MISSING
  MONITORING
  ENFORCING
  INVALID
  ERROR
}

enum DomainDkimStatus {
  UNKNOWN
  MISSING
  PARTIAL
  PUBLISHED
  ERROR
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships              Membership[]
  auditEvents              AuditEvent[]             @relation("AuditUser")
  integrationConsentStates IntegrationConsentState[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships              Membership[]
  auditEvents              AuditEvent[]
  integrations             Integration[]
  integrationConsentStates IntegrationConsentState[]
  findings                 SecurityFinding[]
  domains                  Domain[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Integration {
  id               String              @id @default(cuid())
  organizationId   String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(PENDING)
  externalTenantId String?
  displayName      String?
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorCode    String?
  mfaEvidenceStatus IntegrationCapabilityStatus @default(UNKNOWN)
  mfaEvidenceCheckedAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identities      DirectoryIdentity[]
  roleDefinitions DirectoryRoleDefinition[]
  roleAssignments DirectoryRoleAssignment[]
  findings        SecurityFinding[]
  domains         Domain[]

  @@unique([organizationId, provider])
  @@unique([provider, externalTenantId])
  @@index([organizationId])
}

model DirectoryIdentity {
  id                String                @id @default(cuid())
  integrationId     String
  externalId        String
  displayName       String?
  userPrincipalName String?
  accountEnabled    Boolean?
  identityType              DirectoryIdentityType @default(UNKNOWN)
  createdAtProvider         DateTime?
  isAdmin                   Boolean?
  isMfaRegistered           Boolean?
  isMfaCapable              Boolean?
  isPasswordlessCapable     Boolean?
  methodsRegistered         Json?
  authenticationObservedAt  DateTime?
  authenticationUpdatedAt   DateTime?
  observedAt                DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([integrationId, accountEnabled])
}

model DirectoryRoleDefinition {
  id            String   @id @default(cuid())
  integrationId String
  externalId    String
  templateId    String?
  displayName   String
  isBuiltIn     Boolean?
  observedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration               @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  assignments DirectoryRoleAssignment[]

  @@unique([integrationId, externalId])
  @@index([integrationId])
}

model DirectoryRoleAssignment {
  id                       String   @id @default(cuid())
  integrationId            String
  externalId               String
  principalExternalId      String
  roleDefinitionExternalId String
  directoryScopeId         String?
  observedAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  integration    Integration             @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  roleDefinition DirectoryRoleDefinition @relation(fields: [integrationId, roleDefinitionExternalId], references: [integrationId, externalId], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([integrationId, principalExternalId])
  @@index([integrationId, roleDefinitionExternalId])
}




model Domain {
  id             String            @id @default(cuid())
  organizationId String
  integrationId  String?
  name           String
  isDefault      Boolean           @default(false)
  isInitial      Boolean           @default(false)
  spfStatus      DomainSpfStatus   @default(UNKNOWN)
  spfRecords     Json?
  dmarcStatus    DomainDmarcStatus @default(UNKNOWN)
  dmarcPolicy    String?
  dmarcRecords   Json?
  dkimStatus     DomainDkimStatus  @default(UNKNOWN)
  dkimSelectors  Json?
  dnsObservedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([integrationId])
  @@index([organizationId, isInitial])
}

model SecurityFinding {
  id             String          @id @default(cuid())
  organizationId String
  integrationId  String?
  key            String
  ruleId         String
  title          String
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  evidence       Json?
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, status, severity])
  @@index([integrationId])
}

model IntegrationConsentState {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  provider       IntegrationProvider
  nonceHash      String              @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, expiresAt])
  @@index([userId, expiresAt])
}

model AuditEvent {
  id             String         @id @default(cuid())
  organizationId String
  actorType      AuditActorType
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  occurredAt     DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation("AuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([actorUserId])
}
