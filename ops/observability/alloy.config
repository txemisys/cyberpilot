local.file_match "cyberpilot" {
  path_targets = [
    {
      "__path__" = "/var/log/cyberpilot/*.log",
      "service_name" = "cyberpilot",
      "environment" = "development",
    },
  ]
}

loki.source.file "cyberpilot" {
  targets    = local.file_match.cyberpilot.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
